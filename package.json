{
  "name": "hardhat-project",
  "scripts": {
    "build": "npm run build-contracts && npm run build-ts",
    "build-contracts": "hardhat compile",
    "build-ts": "tsc",
    "server": "exec node ./dist/server/index.js",
    "server:dev": "ts-node server/index.ts",
    "cron": "exec node ./dist/cron/index.js",
    "cron:dev": "ts-node cron/index.ts",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test-deploy": "hardhat test deploy-test/*.test.ts --network mainnet_universal",
    "verify": "hardhat --network scroll etherscan-verify --api-url https://api.scrollscan.com --api-key $API_KEY",
    "migrate": "node-pg-migrate"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "dotenv": "^16.0.3",
    "hardhat": "^2.22.8",
    "hardhat-deploy": "^0.12.4",
    "hardhat-deploy-ethers": "^0.4.2",
    "hardhat-ethers": "^1.0.1",
    "hardhat-etherscan": "^1.0.1"
  },
  "dependencies": {
    "@aave/core-v3": "^1.19.3",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "@uniswap/v3-core": "^1.0.2-solc-0.8-simulate",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.14.1",
    "prom-client": "^15.1.3"
  }
}

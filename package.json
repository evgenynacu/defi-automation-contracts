{
  "name": "hardhat-project",
  "scripts": {
    "build": "npm run build:contracts && npm run build:ts && npm run build:next",
    "build:contracts": "TS_NODE_PROJECT=./tsconfig.server.json hardhat compile",
    "build:ts": "tsc --project tsconfig.server.json",
    "server": "exec node ./dist/server/index.js",
    "server:dev": "ts-node --project tsconfig.server.json server/index.ts",
    "job": "exec node ./dist/context/refinance-job/index.js",
    "job:dev": "ts-node --project tsconfig.server.json context/refinance-job/index.ts",
    "cron": "exec node ./dist/cron/index.js",
    "cron:dev": "ts-node --project tsconfig.server.json cron/index.ts",
    "clean": "TS_NODE_PROJECT=./tsconfig.server.json hardhat clean && rimraf ./dist",
    "test": "TS_NODE_PROJECT=./tsconfig.server.json hardhat test",
    "deploy:tag": "TS_NODE_PROJECT=./tsconfig.server.json npx hardhat deploy --network mainnet_universal --tags",
    "deploy:arb:tag": "TS_NODE_PROJECT=./tsconfig.server.json npx hardhat deploy --network arbitrum_universal --tags",
    "deploy:plasma:tag": "TS_NODE_PROJECT=./tsconfig.server.json npx hardhat deploy --network plasma --tags",
    "test-deploy": "TS_NODE_PROJECT=./tsconfig.server.json hardhat test deploy-test/*.test.ts --network mainnet_universal",
    "verify": "TS_NODE_PROJECT=./tsconfig.server.json hardhat --network mainnet_universal verify 0xbba59d46Bb857dC16E06c22a59a8f250F23A8f7C 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48 0x09D4214C03D01F49544C0448DBE3A27f768F2b34 0xd3fD63209FA2D55B07A0f6db36C2f43900be3094 0x4809010926aec940b550D34a46A52739f996D75D 0x04716DB62C085D9e08050fcF6F7D775A03d07720",
    "migrate": "node-pg-migrate",
    "test:mocha": "TS_NODE_PROJECT=./tsconfig.server.json mocha '**/*.test.ts' --timeout 10000",
    "test:mocha:integration": "TS_NODE_PROJECT=./tsconfig.server.json mocha '**/*.integration.test.ts' --timeout 180000",
    "test:mocha:unit": "TS_NODE_PROJECT=./tsconfig.server.json mocha '**/*.test.ts' --ignore '**/*.integration.test.ts' --timeout 10000",
    "dev:next": "next dev -p ${PORT:-3000}",
    "build:next": "next build",
    "start:next": "next start -p ${PORT:-3000}"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@testcontainers/postgresql": "^11.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "autoprefixer": "^10.4.21",
    "chai": "^4.5.0",
    "dotenv": "^16.0.3",
    "hardhat": "^2.22.8",
    "hardhat-deploy": "^1.0.4",
    "mocha": "^11.7.1",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "testcontainers": "^11.0.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@aave/core-v3": "^1.19.3",
    "@chainlink/contracts": "^1.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@uniswap/v3-core": "^1.0.2-solc-0.8-simulate",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "lucide-react": "^0.525.0",
    "next": "16.1.0-canary.19",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.14.1",
    "prom-client": "^15.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.12.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  }
}

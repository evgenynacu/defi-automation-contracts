    {
      "id": 24,
      "type": "timeseries",
      "title": "Change over $window - early warning",
      "description": "The panel that earns its keep. These venues are too deep to run dry, so the level says little \u2014 a large withdrawal shows up here well before any quote gets worse. Empty until the metrics are at least $window old, since there is nothing to compare against; shorten $window to see it sooner.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (route_pool_liquidity / (route_pool_liquidity offset $window) - 1)",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{venue}} {{token}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (route_pool_v4_liquidity / (route_pool_v4_liquidity offset $window) - 1)",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "{{venue}} (L)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,

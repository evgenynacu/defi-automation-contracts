{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "hardhat.config.ts",
    "./server",
    "./common",
    "./cron",
    "./deploy",
    "./deploy-test",
    "./test",
    "./typechain-types/**/*"
  ]
}
